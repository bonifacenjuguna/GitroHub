########################################
# GitroHub — Environment Configuration
# Copy this file to .env and fill in real values.
# The bot will refuse to start if any REQUIRED value is missing.
########################################

# ---------- Telegram ----------
# Required. Get this from @BotFather after creating your bot.
BOT_TOKEN=

# Required. Your bot's username, without the @ symbol.
BOT_USERNAME=GitroHubBot

# Required. Your numeric Telegram user ID (the ONLY user allowed to use this bot).
# Get yours from @userinfobot on Telegram.
BOT_OWNER_ID=

# Optional but recommended for personalization / logging clarity.
BOT_OWNER_USERNAME=
BOT_OWNER_NAME=

# ---------- Domain / Web ----------
# Required. Public HTTPS domain this app is deployed at (no trailing slash).
DOMAIN=https://gitrohub.vercel.app

# Required. Port the Express server (webhook + OAuth callback) listens on.
# Railway sets this automatically — leave as-is unless testing locally.
PORT=3000

# Required. A long, random secret used to validate incoming Telegram webhook
# requests (sent back as a secret token header). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# ---------- GitHub OAuth ----------
# Required. Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must be: ${DOMAIN}/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---------- Security ----------
# Required. Master key used to derive per-user AES-256-GCM encryption keys
# for encrypting stored GitHub OAuth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit this value. Losing it means all stored tokens become undecryptable.
ENCRYPTION_MASTER_KEY=

# ---------- Database ----------
# Required. Railway auto-injects this when you add the PostgreSQL plugin.
DATABASE_URL=postgresql://user:password@host:5432/gitrohub

# Required. Railway auto-injects this when you add the Redis plugin.
REDIS_URL=redis://default:password@host:6379

# ---------- Runtime ----------
# development | production
NODE_ENV=production

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
