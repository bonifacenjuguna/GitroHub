# GitroHub — environment variables
#
# HOW TO USE ON RAILWAY: open your service → Variables tab → "Raw Editor"
# → paste this whole file in → replace every <PLACEHOLDER> below with a
# real value → Save. That creates every variable at once instead of
# adding them one by one.
#
# Locally: copy this file to `.env` in the project root (same idea —
# `.env` is what dotenv actually reads; this file is just the template)
# and fill in the same placeholders.
#
# Anything marked REQUIRED must have a real value or the bot refuses to
# start (see src/config.js). Anything marked OPTIONAL already has a
# sensible default baked into the code — only set it if you want to
# override that default.

# ── Telegram ─────────────────────────────────────────────────────────
# REQUIRED. From @BotFather after creating your bot.
BOT_TOKEN=<YOUR_BOT_TOKEN_FROM_BOTFATHER>

# REQUIRED. Your own numeric Telegram user ID (not username) — get it
# from @userinfobot. Used for owner-only admin behavior.
OWNER_ID=<YOUR_TELEGRAM_USER_ID>

# ── GitHub OAuth App ─────────────────────────────────────────────────
# REQUIRED. From github.com/settings/developers → OAuth Apps → your app.
# The OAuth app's callback URL must be: <BASE_URL>/oauth/callback
GITHUB_CLIENT_ID=<YOUR_GITHUB_OAUTH_CLIENT_ID>
GITHUB_CLIENT_SECRET=<YOUR_GITHUB_OAUTH_CLIENT_SECRET>

# ── Web server ───────────────────────────────────────────────────────
# REQUIRED. The public URL Railway gives this service (Settings →
# Networking → Public Domain), no trailing slash. Needed for the OAuth
# callback and the Telegram webhook.
BASE_URL=https://<YOUR_APP>.up.railway.app

# OPTIONAL — default 3000. Deliberately left commented out: Railway
# auto-assigns and injects its own PORT for this service, and setting
# a static value here would override that and could break the OAuth
# server / health-check endpoint being reachable at all. Only uncomment
# this if you're running somewhere OTHER than Railway that needs it set
# manually.
# PORT=3000

# OPTIONAL — controls webhook vs. polling mode (see src/index.js) and
# whether Postgres connects over SSL (see src/db/postgres.js). Set this
# to "production" on Railway.
NODE_ENV=production

# ── Secrets (generate your own — never reuse these examples) ────────
# REQUIRED. Signs session tokens. Generate with:
#   openssl rand -hex 32
SESSION_JWT_SECRET=<RUN: openssl rand -hex 32>

# REQUIRED. Encrypts stored GitHub tokens at rest — MUST be exactly 64
# hex characters (32 bytes). Generate with:
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=<RUN: openssl rand -hex 32>

# OPTIONAL. Verifies incoming Telegram webhook requests actually came
# from Telegram. If left unset, one is derived from SESSION_JWT_SECRET
# automatically — fine to start with, but a dedicated secret is
# recommended once this is handling real traffic. Generate with:
#   openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=<RUN: openssl rand -hex 24>

# ── Data stores ──────────────────────────────────────────────────────
# REQUIRED. On Railway, add a PostgreSQL plugin to this project and
# reference its connection string — usually already offered as
# ${{Postgres.DATABASE_URL}} in Railway's variable picker.
DATABASE_URL=<YOUR_POSTGRES_CONNECTION_STRING>

# REQUIRED. Same idea — add a Redis plugin and reference
# ${{Redis.REDIS_URL}} if Railway offers it.
REDIS_URL=<YOUR_REDIS_CONNECTION_STRING>

# ── Tuning (all optional — every one has a working default) ─────────
# Caps V8's own heap so Node respects Railway's actual container memory
# limit instead of growing until the kernel force-kills the process with
# no warning ("Killed" in the logs, no stack trace — Node never gets a
# chance to log anything when this happens). See README's "Memory &
# stability" section for the full reasoning. This number and
# MEMORY_WATCHDOG_MB below are meant to move together — this should stay
# comfortably UNDER whatever your actual Railway plan's memory limit is,
# leaving headroom for buffers/native overhead that live outside V8's
# heap. 384 was sized specifically for Railway's 512MB free/trial tier;
# raise it only if you've upgraded to a plan with more RAM than that.
NODE_OPTIONS=--max-old-space-size=384

# Bot version shown on the ⚙️ Settings screen. You explicitly asked for
# this one to be editable, so it's active here — but a real reminder:
# once this is set, it overrides whatever version the code actually is,
# FOREVER, even across future updates, unless you remember to bump it
# yourself every time (this is exactly what caused the bot to keep
# showing "v0.1.0" long after it was actually much newer). If you'd
# rather the Settings screen always reflect the code's real version with
# zero upkeep, delete this line entirely instead of just leaving it
# unedited.
BOT_VERSION=0.8.1

# General ctx.session TTL, in seconds. Default 24h.
SESSION_TTL_SECONDS=86400

# Postgres connection pool size. Default 3 — tuned for Railway's
# 512MB free-tier ceiling; raise only if you've also upsized the plan.
PG_POOL_MAX=3

# RSS threshold, in MB, before the bot proactively closes Postgres/Redis
# and restarts itself cleanly, rather than risk the kernel hard-killing
# it mid-write. 400 is sized to sit comfortably under Railway's 512MB
# free/trial tier, paired with NODE_OPTIONS's 384MB heap cap above —
# together they leave a real safety margin instead of racing the
# kernel's hard limit. Only raise this if you've confirmed (in Railway's
# own dashboard, Settings → Resources) that this service actually has
# more RAM available than the 512MB free tier — and raise NODE_OPTIONS's
# --max-old-space-size to match if you do, so the two stay paired.
MEMORY_WATCHDOG_MB=400
